{
  "name": "anan-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:web\" \"pnpm dev:admin\"",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:docs": "pnpm --filter docs dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run",
    "gates": "node scripts/gates.mjs",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "build": "pnpm build:web && pnpm build:admin && pnpm build:docs",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "build:docs": "pnpm --filter docs build",
    "mobile:dev": "pnpm --dir apps/mobile dev",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck"
  },
  "dependencies": {
    "@00akshatsinha00/convex-cascading-delete": "^0.1.0",
    "@ai-sdk/openai": "^2.0.57",
    "@ai-sdk/provider": "^3.0.8",
    "@auth/core": "^0.37.0",
    "@browserbasehq/convex-stagehand": "^0.0.2",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/agent": "^0.3.2",
    "@convex-dev/auth": "^0.0.91",
    "@convex-dev/rag": "^0.7.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.3.4",
    "@convex-dev/workpool": "^0.3.2",
    "@djpanda/convex-authz": "^0.1.7",
    "@djpanda/convex-tenants": "^0.1.6",
    "@mzedstudio/llm-cache": "^0.1.0",
    "@mzedstudio/uploadthingtrack": "^0.4.1",
    "@openrouter/ai-sdk-provider": "^1.5.4",
    "@toon-format/toon": "^2.1.0",
    "@types/web-push": "^3.6.4",
    "ai": "^5.0.82",
    "convex": "^1.31.6",
    "convex-audit-log": "^0.2.0",
    "convex-batch-processor": "^1.0.9",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.41",
    "typescript": "^5.2.2",
    "vitest": "^2.0.0"
  }
}
