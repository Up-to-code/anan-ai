{
  "name": "anan-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:web\" \"pnpm dev:client-web\" \"pnpm dev:marketing\" \"pnpm dev:admin\"",
    "dev:web": "pnpm --filter web dev",
    "dev:client-web": "pnpm --filter client-web dev",
    "dev:marketing": "pnpm --filter marketing dev -- --port 3002",
    "dev:admin": "pnpm --filter admin dev",
    "dev:docs": "pnpm --filter docs dev",
    "dev:private-docs": "pnpm --filter private-docs dev",
    "admin:bootstrap-password": "node scripts/bootstrap-admin-password.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run",
    "test:deep:fast": "node scripts/test-deep.mjs fast",
    "test:deep:surfaces": "node scripts/test-deep.mjs surfaces",
    "test:deep:e2e": "node scripts/test-deep.mjs e2e",
    "test:deep:build": "node scripts/test-deep.mjs build",
    "test:deep:optional": "node scripts/test-deep.mjs optional",
    "test:deep": "node scripts/test-deep.mjs deep",
    "test:deep:exhaustive": "node scripts/test-deep.mjs exhaustive",
    "test:client-web": "pnpm --filter client-web test",
    "test:marketing": "pnpm --filter marketing test",
    "test:private-docs": "pnpm --filter private-docs test",
    "gates": "node scripts/gates.mjs",
    "test:e2e:web": "pnpm --filter web test:e2e",
    "test:e2e:web:auth": "pnpm --filter web test:e2e:auth",
    "test:e2e:web:maestro": "pnpm --filter web test:e2e:maestro",
    "test:e2e:web:all": "pnpm test:e2e:web && pnpm test:e2e:web:maestro",
    "test:e2e:client-web": "pnpm --filter client-web test:e2e",
    "build": "pnpm build:web && pnpm build:client-web && pnpm build:marketing && pnpm build:admin && pnpm build:docs && pnpm build:private-docs",
    "build:web": "pnpm --filter web build",
    "build:client-web": "pnpm --filter client-web build",
    "build:marketing": "pnpm --filter marketing build",
    "build:admin": "pnpm --filter admin build",
    "build:docs": "pnpm --filter docs build",
    "build:private-docs": "pnpm --filter private-docs build",
    "lint:private-docs": "pnpm --filter private-docs lint",
    "mobile:dev": "pnpm --dir apps/mobile dev",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck"
  },
  "dependencies": {
    "@00akshatsinha00/convex-cascading-delete": "^0.1.0",
    "@ai-sdk/provider": "^3.0.3",
    "@ai-sdk/provider-utils": "^4.0.6",
    "@auth/core": "^0.37.0",
    "@better-auth/core": "1.5.6",
    "@better-auth/expo": "1.5.6",
    "@browserbasehq/convex-stagehand": "^0.0.2",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/agent": "^0.6.1",
    "@convex-dev/better-auth": "^0.11.4",
    "@convex-dev/rag": "^0.7.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/workflow": "^0.3.4",
    "@convex-dev/workpool": "^0.3.2",
    "@djpanda/convex-authz": "^0.1.7",
    "@djpanda/convex-tenants": "^0.1.6",
    "@mzedstudio/llm-cache": "^0.1.0",
    "@mzedstudio/uploadthingtrack": "^0.4.1",
    "@openrouter/ai-sdk-provider": "^2.0.0",
    "@toon-format/toon": "^2.1.0",
    "@types/web-push": "^3.6.4",
    "ai": "^6.0.35",
    "better-auth": "1.5.6",
    "convex": "^1.31.6",
    "convex-audit-log": "^0.2.0",
    "convex-batch-processor": "^1.0.9",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@types/node": "^20.14.9",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.41",
    "knip": "5.88.1",
    "typescript": "^5.2.2",
    "vitest": "^2.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
