# Convex deployment URL (from npx convex dev in anan-lit root)
# Example: https://keen-oyster-497.eu-west-1.convex.cloud
VITE_CONVEX_URL=https://xxx.convex.cloud

# Convex HTTP/Site URL for auth (defaults .cloud -> .site if not set)
# Required for better-auth Google OAuth callbacks
# See GOOGLE_OAUTH.md for full setup: Google Console, Convex env vars (SITE_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET)
# Example: https://keen-oyster-497.eu-west-1.convex.site
VITE_CONVEX_SITE_URL=https://xxx.convex.site
