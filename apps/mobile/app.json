{
  "expo": {
    "name": "Anan Mobile",
    "slug": "anan-mobile",
    "scheme": "anan-mobile",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "يستخدم عنان الميكروفون لتسجيل الرسائل الصوتية داخل المحادثة وتحويلها إلى نص عندما تختار ذلك.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "experiments": {
