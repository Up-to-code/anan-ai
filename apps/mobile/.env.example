# Copy this file to a private location outside the repo, edit it there, then run:
# ANAN_MOBILE_ENV_FILE=/absolute/path/to/anan-mobile.env pnpm mobile:dev

# Required for live buyer routes.
EXPO_PUBLIC_CONVEX_URL=

# Required for Better Auth's Expo session bridge and Convex HTTP auth routes.
EXPO_PUBLIC_CONVEX_SITE_URL=

# Mobile bridge URL used for save-history and advisor-handoff auth escalation.
EXPO_PUBLIC_CLIENT_WEB_URL=http://localhost:3000

# Optional aliases. If you already use these names, the mobile wrapper maps them
# into the EXPO_PUBLIC_* values above when those values are empty.
CONVEX_URL=
CONVEX_SITE_URL=
