# Required for Vercel (and any deployed) build. Inlined at build time via next.config.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Optional fallback (next.config uses NEXT_PUBLIC_CONVEX_URL ?? CONVEX_URL)
# CONVEX_URL=https://<your-deployment>.convex.cloud

# Required by UploadThing Next route (`app/api/uploadthing/route.ts`).
# This is the UploadThing token (base64 JSON with app metadata).
UPLOADTHING_TOKEN=

# Optional but recommended for browser analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_MOCK_DATA_ENABLED=false
