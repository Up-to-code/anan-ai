# Required for the buyer/client web app.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Optional fallback used by next.config when NEXT_PUBLIC_CONVEX_URL is empty.
# CONVEX_URL=https://<your-deployment>.convex.cloud

# Canonical public origin for metadata and auth-safe URLs.
SITE_URL=http://localhost:3101
NEXT_PUBLIC_SITE_URL=http://localhost:3101

# Optional browser analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional E2E overrides.
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_CLIENT_STORAGE_STATE=
