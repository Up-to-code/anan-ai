# Required for local/deployed Convex access in the buyer-facing client web app.
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Optional fallback if the deployment also exposes `CONVEX_URL`.
# CONVEX_URL=https://<your-deployment>.convex.cloud

# Optional but recommended for buyer funnel analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
