{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "types": ["react", "react-dom", "node"],
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@convex/*": ["../../convex/_generated/*"],
      "@convex/api": ["../../convex/_generated/api.d.ts"],
      "@anan/ag-ui": ["../../packages/ag-ui/src/index.ts"],
      "@anan/ag-ui/react": ["../../packages/ag-ui/src/react/index.ts"],
      "@anan/ag-ui/anan": ["../../packages/ag-ui/src/anan/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
