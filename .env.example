# LLM / OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=
LLM_MAX_RETRIES=

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Serper (web search)
SERPER_API_KEY=
SERPER_WEB_ACTION_TIMEOUT_MS=
SERPER_WEB_ACTION_MAX_RETRIES=

# Browserbase / Stagehand
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
MODEL_API_KEY=

# UploadThing
# Web upload route (`apps/web/app/api/uploadthing/route.ts`) requires this token.
UPLOADTHING_TOKEN=
# Convex UploadThing webhook verification (`convex/http.ts`) uses this key in deployment env.
UPLOADTHING_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Better Auth + Convex
# In local dev these usually point at the web app origin and active Convex deployment.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ADMIN_SIGNUP_BRIDGE_SECRET=
NEXT_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
# Mobile bridge URL used by `apps/mobile` for save-history and advisor-handoff auth escalation.
EXPO_PUBLIC_CLIENT_WEB_URL=http://localhost:3000
# Live Convex URL used by apps/mobile when backend-backed buyer flows are enabled.
EXPO_PUBLIC_CONVEX_URL=
# Optional canonical web URL for redirects when Convex is hosted on `*.convex.site`.
# Set this in Convex env + web/admin deployments (e.g. https://app.anan.sa).
ANAN_WEB_URL=
# Optional comma-separated allowlist of additional redirect origins (local dev, staging, etc).
# Example: http://localhost:3000,http://127.0.0.1:3000
ANAN_AUTH_ALLOWED_ORIGINS=
JWT_PRIVATE_KEY=
JWKS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional email OTP delivery. Keep OTP UI disabled until a sender is configured.
EMAIL_OTP_FROM=
RESEND_API_KEY=
