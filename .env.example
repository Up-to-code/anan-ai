# LLM / OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_EMBEDDING_MODEL=
LLM_MAX_RETRIES=

# Serper (web search)
SERPER_API_KEY=
SERPER_WEB_ACTION_TIMEOUT_MS=
SERPER_WEB_ACTION_MAX_RETRIES=

# Browserbase / Stagehand
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
MODEL_API_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Convex Auth (Google OAuth)
# `SITE_URL` is used by Convex Auth as the default post-login redirect base.
# In local dev it should match the web app origin (usually http://localhost:3000).
SITE_URL=http://localhost:3000
# Optional canonical web URL for redirects when Convex is hosted on `*.convex.site`.
# Set this in Convex env + web/admin deployments (e.g. https://app.anan.sa).
ANAN_WEB_URL=
JWT_PRIVATE_KEY=
JWKS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
